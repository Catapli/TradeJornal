APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cloud
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Envío real: MAIL_MAILER=resend + la clave de API. En local se queda en `log`.
RESEND_KEY=

# Resumen semanal por correo (Fase 4, R1). El comando `resumen:semanal` corre
# cada hora y escribe a quien en ese momento tenga este día y esta hora en su
# propio huso. WEEKLY_SUMMARY_DAY sigue a Carbon: 0 = domingo.
WEEKLY_SUMMARY_ENABLED=true
WEEKLY_SUMMARY_DAY=0
WEEKLY_SUMMARY_HOUR=18

# Hora local a partir de la cual deja de ofrecerse el ritual pre-mercado.
PRE_MARKET_UNTIL_HOUR=22

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (almacenamiento de screenshots y charts)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_URL=
R2_BUCKET=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Google OAuth (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_REDIRECTS=http://localhost:8000/auth/google-callback


# IA (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
AI_DAILY_LIMIT_FREE=3
AI_DAILY_LIMIT_PRO=15

# Stripe / Cashier
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

VITE_APP_NAME="${APP_NAME}"

# Demo pública de solo lectura (/demo). El usuario lo crea `php artisan demo:refresh`.
DEMO_ENABLED=true
DEMO_EMAIL=demo@tradeforge.app
DEMO_NAME="Trader Demo"

# Facturación (config/billing.php)
TRIAL_DAYS=14            # 0 desactiva la prueba de PRO para las altas nuevas
ACCOUNT_LIMIT_FREE=3     # cuentas activas del plan gratuito; PRO no tiene tope
RECOVERY_COUPON=         # código de Stripe que se ofrece al quemar una cuenta

# Freno de los endpoints del `.exe` de MetaTrader, por minuto (config/services.php).
# Un terminal normal sincroniza una vez por minuto. El tope por IP es más alto
# para no frenar una oficina con varios terminales tras el mismo NAT, y es el que
# acota la fuerza bruta sobre sync_token.
MT5_RATE_LIMIT_TOKEN=60
MT5_RATE_LIMIT_IP=120
