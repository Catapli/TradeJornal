# Normalización de finales de línea: todo el texto se guarda y se extrae en LF.
* text=auto eol=lf

# Diffs con contexto de lenguaje
*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Binarios: sin normalización ni diff textual
*.exe binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary

# Ficheros generados: colapsados en el diff y sin conflictos de merge manuales
composer.lock -diff merge=binary
package-lock.json -diff merge=binary

# Scripts que Windows exige en CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Excluidos del archive/export
/.github export-ignore
/tests export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
.editorconfig export-ignore
phpunit.xml export-ignore
